# Copy to .env.local or a Vercel environment variable for local development.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Edge Function secrets (configure in Supabase, never in Vite/browser variables):
# LIQUID_CASH_CODE_PEPPER=generate-a-long-random-secret
# RESEND_API_KEY=existing-verified-resend-api-key
# LIQUID_CASH_FROM_EMAIL=optional-verified-sender-or-use-TASK_NOTIFICATION_FROM_EMAIL
# TASK_NOTIFICATION_FROM_EMAIL=existing-verified-Resend-sender
# INVOICE_FROM_EMAIL=CRT Roofing Accounting <accounting@crtroofing.com>
# ACCOUNT_ACCESS_FROM_EMAIL=CRT Roofing Access <notifications@crtroofing.com>
# ACCOUNT_VAULT_ENCRYPTION_KEY=generate-a-unique-random-secret-at-least-32-characters
# TASK_NOTIFICATION_APP_URL=https://your-app.example.com/
# TASK_NOTIFICATION_WEBHOOK_SECRET=shared-secret-for-task-and-proposal-database-webhooks
